# ============================================================
# Project Sentinel — Root .gitignore
# ============================================================

# --- Secrets (NEVER commit) ---
.env
.env.local
.env.development
.env.production
.env.*.local

# --- Phase 2 patch backups (written by PatchApplier into the bind-mounted
#     source tree of each patchable service). Never commit — these contain
#     timestamped pre-images of patched files and the directory rewrites itself
#     on every apply. The pattern matches lab-rat/, order-service/,
#     payment-service/, and any future patchable service registered in
#     PatchPathValidator.SERVICES. ---
**/src/.sentinel-backups/

# --- Gradle (root-level cache and build) ---
.gradle/
build/

# --- Java build artifacts ---
*.jar
!gradle/wrapper/gradle-wrapper.jar

# --- IDE — IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- IDE — VS Code ---
.vscode/

# --- Logs ---
*.log
*.log.*.gz
application.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Profiler temp output ---
sentinel-profiler-*.txt
