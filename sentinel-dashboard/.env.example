# Dashboard environment template — copy to .env before building.
#
# Vite reads:
#   - .env              for ALL builds (npm run dev AND npm run build)
#   - .env.development  for `npm run dev` only
#   - .env.production   for `npm run build` only
#
# The production bundle (what nginx serves in Docker) is built with
# `npm run build` and so reads .env. Both files below are gitignored.

VITE_API_BASE=http://localhost:8081

# Bearer token sent on POST /api/patches/{id}/approve|reject|rollback.
# MUST exactly match AGENT_PATCH_SECRET in the root .env (the agent's secret).
# Set to a 32+ char random value before any non-loopback use. Do NOT commit.
VITE_PATCH_TOKEN=set-me-to-match-AGENT_PATCH_SECRET
