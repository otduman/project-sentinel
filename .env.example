# Copy this file to .env and fill in your values.

GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL credentials (used by sentinel-agent and the postgres container)
DB_USERNAME=sentinel
DB_PASSWORD=changeme_db

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana

# REQUIRED — shared secret for the AlertManager → sentinel-agent webhook.
# AlertController.validateConfig fails fast at startup if this is blank, so
# the agent will refuse to boot until it's set. AlertManager must send
# Authorization: Bearer <value> on every webhook POST.
# Rationale: unauthenticated webhooks allow token-burn DoS (anyone can
# inject fake resolved-status messages that close active episodes).
AGENT_WEBHOOK_SECRET=changeme_webhook_secret

# REQUIRED for Phase 2 patch approval — bearer token guarding the /api/patches
# approve/reject/rollback endpoints. These endpoints will write to the lab-rat
# source tree, so this token MUST be set; blank means endpoints are disabled.
# The dashboard reads VITE_PATCH_TOKEN to send a matching Authorization header.
AGENT_PATCH_SECRET=changeme_patch_secret
