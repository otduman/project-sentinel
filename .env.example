# Copy this file to .env and fill in your values.

GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL credentials (used by sentinel-agent and the postgres container)
DB_USERNAME=sentinel
DB_PASSWORD=changeme_db

# Grafana admin credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana

# Optional: shared secret for the AlertManager → sentinel-agent webhook
# When set, AlertManager must send: Authorization: Bearer <value>
# Leave commented out to disable the check (safe for local/Docker-only setups)
# AGENT_WEBHOOK_SECRET=changeme_webhook
